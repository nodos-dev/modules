{
	"nodes": [
		{
			"class_name": "QuadMerge",
			"menu_info": {
				"category": "Compositing",
				"display_name": "Quad Merge",
				"name_aliases": [
					"combine",
					"concatenate",
					"add",
					"quarter",
					"texture",
					"quad",
					"canvas",
					"layout"
				]
			},
			"node": {
				"class_name": "QuadMerge",
				"contents_type": "Job",
				"contents": {
					"type": "nos.sys.vulkan.GPUNode",
					"options": {
						"shader": "Shaders/QuadMerge.frag"
					}
				},
				"description": "Creates an output texture using its 4 inputs for each quadrant.\nMay be used as a simple multi-viewer or as a combiner for quadrant image inputs",
				"pins": [
					{
						"name": "Input0",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Quadrant 0: top/left"
					},
					{
						"name": "Input1",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Quadrant 1: top/right"
					},
					{
						"name": "Input2",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Quadrant 2: bottom/left"
					},
					{
						"name": "Input3",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Quadrant 3: bottom/right"
					},
					{
						"name": "Resolution",
						"type_name": "nos.fb.vec2u",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": {
							"x": 1920,
							"y": 1080
						},
						"description": "Resolution of the merged output texture",
						"visualizers": [
							{
								"type": "NAMED_VALUE",
								"name": "nos.mediaio.ResolutionVisualizer"
							}
						]
					},
					{
						"name": "Output",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_OR_PROPERTY",
						"extensions": [
							{
								"name": "texture_options",
								"type_name": "nos.sys.vulkan.TexturePinOptions",
								"data": {
									"unscaled": true
								}
							}
						]
					}
				]
			}
		}
	],
	"schema_version": "1.4-v1"
