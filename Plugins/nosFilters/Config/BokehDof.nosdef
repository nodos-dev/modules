{
	"nodes": [
		{
			"class_name": "BokehDof",
			"menu_info": {
				"category": "Filters",
				"display_name": "Bokeh DoF"
			},
			"node": {
				"class_name": "BokehDof",
				"name": "Bokeh DoF",
				"description": "Single-pass 2D depth-of-field. CoC follows a physical thin-lens model (Aperture, Focus\nDistance, Fov) from a linear view-space Z input. Scatter-as-gather: each pixel in the MaxCoc\nsearch radius spreads over its own CoC disc, shaped by the BokehShape kernel texture and\nnormalized by disc area, so energy is conserved and defocused foregrounds bleed over sharp\nneighbors as a real lens does.",
				"contents_type": "Job",
				"contents": {
					"type": "nos.sys.vulkan.GPUNode",
					"options": {
						"shader": "Shaders/BokehDof.frag"
					}
				},
				"pins": [
					{
						"name": "Input",
						"display_name": "Input",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Source colour texture the depth-of-field is applied to.",
						"data": {
							"filtering": "LINEAR"
						}
					},
					{
						"name": "Depth",
						"display_name": "Depth",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Linear view-space Z per pixel, read from the red channel. Drives the circle of confusion.",
						"data": {
							"filtering": "NEAREST"
						}
					},
					{
						"name": "BokehShape",
						"display_name": "Bokeh Shape",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Kernel texture sampled across the unit disc; the shape painted into it becomes the bokeh.",
						"data": {
							"filtering": "LINEAR"
						}
					},
					{
						"name": "FocusDistance",
						"display_name": "Focus Distance",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Depth that stays perfectly sharp, in the same units as the Depth input.",
						"data": 5.0,
						"min": 0.0,
						"max": 1000.0
					},
					{
						"name": "Aperture",
						"display_name": "Aperture (lens radius)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Thin-lens radius in the same world units as the Depth input. Larger values give a\nshallower depth of field.",
						"data": 0.03,
						"min": 0.0,
						"max": 1.0
					},
					{
						"name": "Fov",
						"display_name": "FOV (vertical, degrees)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Vertical field of view of the camera that rendered the inputs, in degrees; projects\nthe world-space blur radius to pixels.",
						"data": 60.0,
						"min": 1.0,
						"max": 179.0
					},
					{
						"name": "MaxCoc",
						"display_name": "Max CoC (pixels)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Largest circle of confusion this pass can represent, and the gather search radius; blur\nbeyond it is truncated. Zero disables the effect.",
						"data": 16.0,
						"min": 0.0,
						"max": 128.0
					},
					{
						"name": "BackgroundIsFar",
						"display_name": "Background Is Far",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "How pixels with zero depth are treated: 0 keeps them in focus, 1 pushes them to the far plane.",
						"data": 1.0,
						"min": 0.0,
						"max": 1.0
					},
					{
						"name": "SampleCount",
						"display_name": "Sample Count",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Ceiling for the adaptive tap count. The pass takes as many Vogel-disc samples as Max CoC\nneeds for a ~1.5 pixel spacing, but never more than this.",
						"data": 128.0,
						"min": 8.0,
						"max": 512.0
					},
					{
						"name": "KernelRotation",
						"display_name": "Kernel Rotation (radians)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Rotates the bokeh kernel lookup. Useful for animating highlights.",
						"data": 0.0,
						"min": -6.2832,
						"max": 6.2832
					},
					{
						"name": "Output",
						"display_name": "Output",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_OR_PROPERTY",
						"description": "The input image with depth-of-field applied."
					}
				]
			}
		}
	]
}
