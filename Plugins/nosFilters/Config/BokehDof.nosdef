{
	"nodes": [
		{
			"class_name": "BokehDof",
			"menu_info": {
				"category": "Filters",
				"display_name": "Bokeh DoF"
			},
			"node": {
				"class_name": "BokehDof",
				"name": "Bokeh DoF",
				"description": "Single-pass thin-lens depth-of-field with physical camera parameters (focal length,\naperture diameter, focus distance). Reads linear Z in metres from the depth input's red\nchannel; zero or negative depth stays sharp. Scatter-as-gather disk sampler: the gather\nradius follows the center pixel's circle of confusion and each tap is weighted by how far\nits own disc reaches, so sharp foregrounds do not bleed onto a blurred background. Taps are\nadditionally shaped by the BokehShape kernel texture; a plain white disc reproduces a circular\naperture.",
				"contents_type": "Job",
				"contents": {
					"type": "nos.sys.vulkan.GPUNode",
					"options": {
						"shader": "Shaders/BokehDof.frag"
					}
				},
				"pins": [
					{
						"name": "Input",
						"display_name": "Input",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Source colour texture the depth-of-field is applied to.",
						"data": {
							"filtering": "LINEAR"
						}
					},
					{
						"name": "Depth",
						"display_name": "Depth",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Linear Z in metres per pixel, read from the red channel. Zero or negative values are\nbackground and stay sharp.",
						"data": {
							"filtering": "NEAREST"
						}
					},
					{
						"name": "BokehShape",
						"display_name": "Bokeh Shape",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Kernel texture sampled across the unit disc; the shape painted into it becomes the bokeh.\nFeed from a Bokeh Shape node. Must be connected: an empty texture zeroes every tap and the\nimage passes through unblurred.",
						"data": {
							"filtering": "LINEAR"
						}
					},
					{
						"name": "FocalMm",
						"display_name": "Focal Length (mm)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Lens focal length in millimetres.",
						"data": 32.0,
						"min": 1.0,
						"max": 300.0
					},
					{
						"name": "ApertureMm",
						"display_name": "Aperture (mm)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Aperture diameter in millimetres: focal length divided by the f-stop. Larger values give\na shallower depth of field.",
						"data": 11.43,
						"min": 0.0,
						"max": 100.0
					},
					{
						"name": "FocusM",
						"display_name": "Focus Distance (m)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Distance that stays perfectly sharp, in metres.",
						"data": 10.0,
						"min": 0.1,
						"max": 1000.0
					},
					{
						"name": "PxPerMm",
						"display_name": "Pixels Per Sensor mm",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Projects the sensor-space blur circle to output pixels: image width in pixels divided\nby sensor width in millimetres.",
						"data": 80.0,
						"min": 1.0,
						"max": 500.0
					},
					{
						"name": "MaxBlurPx",
						"display_name": "Max Blur (pixels)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Largest circle of confusion this pass can represent, in pixels; blur beyond it is\ntruncated. Zero disables the effect.",
						"data": 60.0,
						"min": 0.0,
						"max": 128.0
					},
					{
						"name": "ShowCoC",
						"display_name": "Show CoC",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Renders the circle-of-confusion heatmap (green sharp to red max blur) instead of\nthe image.",
						"data": false
					},
					{
						"name": "SampleCount",
						"display_name": "Sample Count",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Ceiling for the adaptive tap count. The pass takes as many disc taps as the gather radius\nneeds for a ~1.5 pixel spacing, but never more than this.",
						"data": 128.0,
						"min": 8.0,
						"max": 512.0
					},
					{
						"name": "KernelRotation",
						"display_name": "Kernel Rotation (radians)",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Rotates the bokeh kernel lookup. Smooth per-frame rotation without regenerating the\nshape texture.",
						"data": 0.0,
						"min": -6.2832,
						"max": 6.2832
					},
					{
						"name": "Output",
						"display_name": "Output",
						"type_name": "nos.sys.vulkan.Texture",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_OR_PROPERTY",
						"description": "The input image with depth-of-field applied."
					}
				]
			}
		}
	]
}
