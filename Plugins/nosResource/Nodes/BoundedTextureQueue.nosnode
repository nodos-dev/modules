          ], "comments": [
            {
              "id": "6dce16dd-7253-4382-96b2-64a9178c91f5",
              "name": "Comment (8)",
              "hint": "Hint",
              "content": "Copy output texture to different texture every frame provided by the texture provider node\ninside the graph. They are then pushed to the object queue at the end of the DMA thread.",
              "pos": { "x": 1499.0, "y": 829.0 },
              "size": { "x": 570.0, "y": 242.0 },
              "bg_color": { "x": 0.0, "y": 0.548673, "z": 1.0, "w": 0.3 }
            },
            {
              "id": "5c7eeee1-5cdb-43f8-96ea-3ec78d4a5c08",
              "name": "Comment (9)",
              "hint": "Hint",
              "content": "Starts the GPU copy of texture object pulled from bounded\nqueue to a new texture object and signals the texture providers\nthat host use of this texture object is finished.",
              "pos": { "x": 2519.0, "y": 771.0 },
              "size": { "x": 394.0, "y": 160.0 },
              "bg_color": { "x": 0.60177, "y": 0.575143, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "db858fd9-fda7-4e9a-ab72-35d1891b21b6",
              "name": "Comment (5)",
              "hint": "Hint",
              "content": "Queues texture composite objects into the bounded queue to be used by the consumer thread. Schedules DMA thread execution when a slot is available in the bounded queue.",
              "pos": { "x": 2049.0, "y": 780.0 },
              "size": { "x": 490.0, "y": 144.0 },
              "bg_color": { "x": 0.884955, "y": 0.0, "z": 1.0, "w": 0.3 }
            }
          ], "connections": [
            { "from": "744a985c-9395-4aeb-a4ec-16303b9b0289", "to": "2640b81c-67b6-480a-8d43-7e5ac01aaaa0", "id": "87af755d-af04-4b39-9c58-59ac562fbd2f" },
